<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Winche.Secrets</PackageId>
    <Description>Winche's secrets (passwords, API keys, client secrets): encrypted with the project's master key in its PostgreSQL database.</Description>
    <PackageTags>secrets;encryption;postgresql</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Secrets.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="Winche.Core" Version="2.0.0" />
  </ItemGroup>
</Project>
