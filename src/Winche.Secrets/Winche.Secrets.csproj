<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Winche.Secrets</PackageId>
    <RootNamespace>Winche.Secrets</RootNamespace>
    <PackageDescription>Winche's secrets (passwords, API keys, client secrets): each a value encrypted with the master key in the project's PostgreSQL database, or a reference to where it's kept (ISecretSource: Winche.Secrets.Aws reads AWS Secrets Manager and Parameter Store).</PackageDescription>
    <PackageTags>secrets;encryption;postgresql</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Secrets.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Winche.Core" Version="2.0.0" />
  </ItemGroup>
</Project>
