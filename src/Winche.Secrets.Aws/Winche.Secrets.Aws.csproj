<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Winche.Secrets.Aws</PackageId>
    <RootNamespace>Winche.Secrets.Aws</RootNamespace>
    <PackageDescription>Winche secrets read from AWS Secrets Manager (aws-sm) and Systems Manager Parameter Store (aws-ssm), with the app's own AWS credentials or a project's own key.</PackageDescription>
    <PackageTags>secrets;aws;secrets-manager;parameter-store</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Winche.Secrets.Aws.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.5.5" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.8.1" />
    <ProjectReference Include="..\Winche.Secrets\Winche.Secrets.csproj" />
  </ItemGroup>
</Project>
